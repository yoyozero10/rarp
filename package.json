{
  "name": "rarp",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "files": ["dist/**/*.js", "dist/ui", "schemas/*.json", "docs/*.md"],
  "description": "Local multi-agent orchestration runtime and CLI",
  "type": "module",
  "bin": {
    "rarp": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.json && vite build --config ui/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build",
    "test:package": "node scripts/package-check.mjs"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
